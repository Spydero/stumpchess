{
  "name": "chess-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @chess/server --filter @chess/web dev",
    "dev:web": "pnpm --filter @chess/web dev",
    "dev:server": "pnpm --filter @chess/server dev",
    "build": "pnpm --filter @chess/shared build && pnpm --filter @chess/db build && pnpm --filter @chess/server build && pnpm --filter @chess/web build",
    "db:generate": "pnpm --filter @chess/db generate",
    "db:push": "pnpm --filter @chess/db push",
    "db:seed": "pnpm --filter @chess/db seed",
    "db:ensure-owner": "pnpm --filter @chess/db seed",
    "db:reset-owner-password": "OWNER_RESET_PASSWORD=1 pnpm --filter @chess/db seed",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "postinstall": "pnpm db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
