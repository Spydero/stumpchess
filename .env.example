# PostgreSQL (required — SQLite is not supported)
#
# Docker Compose (recommended for a clean local setup):
#   pnpm db:up
#   DATABASE_URL="postgresql://stumpchess:stumpchess@localhost:5432/stumpchess"
#
# Homebrew Postgres:
#   brew services start postgresql@18
#   createdb stumpchess
#   DATABASE_URL="postgresql://YOUR_OS_USER@localhost:5432/stumpchess"
DATABASE_URL="postgresql://stumpchess:stumpchess@localhost:5432/stumpchess"

BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"
SERVER_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# Optional Google OAuth (link account)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Owner seed (change password after first login)
OWNER_EMAIL="jojo@local.dev"
OWNER_PASSWORD="OwnerChangeMe123!"
